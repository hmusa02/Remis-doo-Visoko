---
import Icon from './Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Putanja" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-500">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <Icon name="chevron-right" size={14} class="text-ink-300" />
          )}
          {c.href && i < items.length - 1 ? (
            <a href={c.href} class="hover:text-ink-900 transition-colors">
              {c.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink-900 font-medium">
              {c.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
