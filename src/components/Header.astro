---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

/** Zaglavlje s navigacijom, dropdownom stanica i mobilnim menijem (bez skladištenja). */
interface Props {
  active?: string;
}
const { active } = Astro.props;

const stanice = (await getCollection('stanice')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);

const nav = [
  { label: 'Početna', href: '/' },
  { label: 'Stanice', href: '/stanice', dropdown: true },
  { label: 'Usluge', href: '/usluge' },
  { label: 'Cjenovnik', href: '/cjenovnik' },
  { label: 'Karijera', href: '/karijera' },
  { label: 'Kontakt', href: '/kontakt' },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-ink-200">
  <div class="wrap flex items-center justify-between h-16">
    <a href="/" aria-label="REMIS — početna">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-0.5" aria-label="Glavna navigacija">
      {
        nav.map((n) =>
          n.dropdown ? (
            <div class="dropdown">
              <a
                href={n.href}
                class="nav-link inline-flex items-center gap-1"
                aria-current={active === n.href ? 'page' : undefined}
                aria-haspopup="true"
              >
                {n.label}
                <Icon name="chevron-down" size={14} />
              </a>
              <div class="dropdown-panel">
                {stanice.map((s) => (
                  <a href={`/stanice/${s.data.slug}`} class="dropdown-item">
                    <span>{s.data.naziv}</span>
                    <span class="grad">{s.data.grad}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={n.href}
              class="nav-link"
              aria-current={active === n.href ? 'page' : undefined}
            >
              {n.label}
            </a>
          ),
        )
      }
    </nav>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 rounded-md text-ink-900 hover:bg-ink-100"
      aria-label="Otvori meni"
      aria-expanded="false"
      aria-controls="mobilni-meni"
      data-menu-toggle
    >
      <Icon name="menu" size={24} class="block" data-menu-icon="open" />
      <Icon name="close" size={24} class="hidden" data-menu-icon="close" />
    </button>
  </div>

  <div id="mobilni-meni" class="md:hidden hidden border-t border-ink-200 bg-white" data-menu-panel>
    <nav class="wrap py-3 flex flex-col" aria-label="Glavna navigacija (mobilna)">
      <a href="/" class="mobilni-link" aria-current={active === '/' ? 'page' : undefined}>Početna</a>

      <details class="border-b border-ink-100">
        <summary class="mobilni-link list-none flex items-center justify-between cursor-pointer">
          <span>Stanice</span>
          <Icon name="chevron-down" size={18} class="text-ink-400" />
        </summary>
        <div class="pb-2">
          <a href="/stanice" class="block py-2 pl-3 text-sm font-semibold text-brand-700">Sve stanice →</a>
          {stanice.map((s) => (
            <a href={`/stanice/${s.data.slug}`} class="block py-2 pl-3 text-sm text-ink-700">
              {s.data.naziv} <span class="text-ink-400">· {s.data.grad}</span>
            </a>
          ))}
        </div>
      </details>

      <a href="/usluge" class="mobilni-link" aria-current={active === '/usluge' ? 'page' : undefined}>Usluge</a>
      <a href="/cjenovnik" class="mobilni-link" aria-current={active === '/cjenovnik' ? 'page' : undefined}>Cjenovnik</a>
      <a href="/karijera" class="mobilni-link" aria-current={active === '/karijera' ? 'page' : undefined}>Karijera</a>
      <a href="/kontakt" class="mobilni-link" aria-current={active === '/kontakt' ? 'page' : undefined}>Kontakt</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const ikonaOpen = document.querySelector<HTMLElement>('[data-menu-icon="open"]');
  const ikonaClose = document.querySelector<HTMLElement>('[data-menu-icon="close"]');

  function postavi(otvoren: boolean): void {
    if (!panel || !toggle) return;
    panel.classList.toggle('hidden', !otvoren);
    toggle.setAttribute('aria-expanded', String(otvoren));
    toggle.setAttribute('aria-label', otvoren ? 'Zatvori meni' : 'Otvori meni');
    ikonaOpen?.classList.toggle('hidden', otvoren);
    ikonaClose?.classList.toggle('hidden', !otvoren);
  }

  toggle?.addEventListener('click', () => {
    postavi(panel?.classList.contains('hidden') ?? true);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') postavi(false);
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) postavi(false);
  });
</script>
