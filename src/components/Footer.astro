---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { firma } from '../data/firma';
import { telefonHref } from '../lib/format';

/**
 * Podnožje. Svijetla podloga, bordo logo (SVG, currentColor). Sadrži
 * sjedište firme — koje NIJE stanica tehničkog pregleda.
 */
const godina = new Date().getFullYear();

const linkovi = [
  { label: 'Stanice', href: '/stanice' },
  { label: 'Usluge', href: '/usluge' },
  { label: 'Cjenovnik', href: '/cjenovnik' },
  { label: 'Vodič', href: '/info' },
  { label: 'O nama', href: '/o-nama' },
  { label: 'Kontakt', href: '/kontakt' },
];
const telSjediste = telefonHref(firma.telefon);
---

<footer class="bg-ink-100 border-t border-ink-200 text-ink-600 mt-24">
  <div class="wrap py-12 md:py-16 grid gap-10 md:grid-cols-3">
    <div class="max-w-xs">
      <span class="text-brand-700"><Logo height={38} /></span>
      <p class="mt-4 text-sm leading-relaxed text-ink-500">
        Tehnički pregled i registracija vozila u Federaciji BiH. Deset stanica,
        jedan standard — pouzdano i tačno.
      </p>
    </div>

    <div>
      <h2 class="text-eyebrow uppercase text-ink-500 mb-4">Navigacija</h2>
      <ul class="space-y-2.5 text-sm">
        {
          linkovi.map((l) => (
            <li>
              <a href={l.href} class="hover:text-brand-700 transition-colors">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-eyebrow uppercase text-ink-500 mb-4">Sjedište firme</h2>
      <address class="not-italic space-y-2.5 text-sm">
        <p class="flex items-start gap-2.5">
          <Icon name="building" size={16} class="text-ink-400 mt-0.5 shrink-0" />
          <span>
            {firma.naziv} <span class="text-ink-400">(uprava)</span><br />
            {firma.adresa}, {firma.postanskiBroj} {firma.grad}
          </span>
        </p>
        <a href={`tel:${telSjediste}`} class="flex items-center gap-2.5 hover:text-brand-700 transition-colors">
          <Icon name="phone" size={16} class="text-ink-400 shrink-0" />
          <span class="tabular-nums">{firma.telefon}</span>
        </a>
        <a href={`mailto:${firma.email}`} class="flex items-center gap-2.5 hover:text-brand-700 transition-colors">
          <Icon name="mail" size={16} class="text-ink-400 shrink-0" />
          <span>{firma.email}</span>
        </a>
        <a href={`https://${firma.web}`} class="flex items-center gap-2.5 hover:text-brand-700 transition-colors">
          <Icon name="globe" size={16} class="text-ink-400 shrink-0" />
          <span>{firma.web}</span>
        </a>
      </address>
    </div>
  </div>

  <div class="border-t border-ink-200">
    <div class="wrap py-6 space-y-2 text-xs text-ink-500">
      <p class="text-ink-600">{firma.puniNaziv}</p>
      <p>
        Registrovano kod: {firma.sud} · Matični registarski broj: {firma.maticniBroj} ·
        ID: {firma.idBroj}
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 pt-1">
        <p>© {godina} {firma.naziv}. Sva prava zadržana.</p>
        <p>Tehnički pregledi vozila · Federacija BiH</p>
      </div>
    </div>
  </div>
</footer>
