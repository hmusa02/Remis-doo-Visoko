---
/** Naslov sekcije: nadnaslov (eyebrow) + naslov + opcioni opis. */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
}
const { eyebrow, title, description, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<div class={align === 'center' ? 'text-center max-w-2xl mx-auto' : 'max-w-2xl'}>
  {eyebrow && (
    <p class="text-eyebrow uppercase text-accent-strong mb-2.5">{eyebrow}</p>
  )}
  <Tag class="text-title text-ink-900">{title}</Tag>
  {description && (
    <p class="mt-3 text-ink-600 leading-relaxed">{description}</p>
  )}
</div>
