---
import Icon from './Icon.astro';

/** Prazno stanje — npr. kad nema aktivnih oglasa. Akcija ide u <slot />. */
interface Props {
  icon?: 'inbox' | 'clock' | 'mail' | 'map-pin' | 'building';
  title: string;
  message?: string;
}
const { icon = 'inbox', title, message } = Astro.props;
---

<div class="text-center py-12 px-6 border border-dashed border-ink-300 rounded-card bg-ink-50">
  <div class="mx-auto w-12 h-12 rounded-full bg-ink-100 flex items-center justify-center text-ink-400">
    <Icon name={icon} size={22} />
  </div>
  <h3 class="mt-4 font-display font-bold text-lg text-ink-900">{title}</h3>
  {message && <p class="mt-1.5 text-sm text-ink-500 max-w-sm mx-auto">{message}</p>}
  <div class="mt-5 empty:hidden"><slot /></div>
</div>
