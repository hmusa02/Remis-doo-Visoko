---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/** Standardni layout stranice: zaglavlje + sadržaj + podnožje. */
interface Props {
  title: string;
  description?: string;
  active?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, active, image, ogType, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} ogType={ogType} noindex={noindex}>
  <Header active={active} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
