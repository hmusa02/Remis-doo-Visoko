---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { firma } from '../data/firma';
import type { MarkerPodatak } from '../lib/mapa';

const stanice = (await getCollection('stanice')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);
const usluge = (await getCollection('usluge')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);

const markeri: MarkerPodatak[] = stanice.map((s) => ({
  slug: s.data.slug,
  naziv: s.data.naziv,
  lng: s.data.lng,
  lat: s.data.lat,
}));

// Lista za izbor lokacije — jedna stavka po stanici (dva Konjica se razlikuju).
// Labela je naziv bez prefiksa firme; sortirano abecedno.
const gradoviList = stanice
  .map((s) => ({
    slug: s.data.slug,
    labela: s.data.naziv.replace(/^(REMIS|Transport)\s+/, ''),
    lng: s.data.lng,
    lat: s.data.lat,
  }))
  .sort((a, b) => a.labela.localeCompare(b.labela, 'bs'));

const brzi = [
  { naziv: 'Cjenovnik', opis: 'Cijene po kategorijama vozila', href: '/cjenovnik', icon: 'clipboard-check' as const },
  { naziv: 'Potrebni dokumenti', opis: 'Šta ponijeti na pregled', href: '/info', icon: 'check' as const },
  { naziv: 'Kontakt', opis: 'Pozovite ili nam pišite', href: '/kontakt', icon: 'phone' as const },
];

const brojevi = [
  { broj: '10', opis: 'Stanica u Federaciji BiH', count: 10 },
  { broj: String(firma.osnovana), opis: 'Godina od osnivanja', count: null },
  { broj: `${firma.zaposleni}`, opis: 'Zaposlenih', count: firma.zaposleni },
];

const organizacijaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: firma.naziv,
  legalName: firma.puniNaziv,
  url: new URL('/', Astro.site).href,
  sameAs: [`https://${firma.web}`],
  logo: new URL('/favicon.svg', Astro.site).href,
  foundingDate: String(firma.osnovana),
  telephone: firma.telefon,
  email: firma.email,
  taxID: firma.idBroj,
  identifier: firma.maticniBroj,
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.adresa,
    postalCode: firma.postanskiBroj,
    addressLocality: firma.grad,
    addressCountry: 'BA',
  },
  areaServed: 'Federacija Bosne i Hercegovine',
};
---

<PageLayout
  title="REMIS — Tehnički pregledi vozila | Federacija BiH"
  description="REMIS d.o.o. Visoko — tehnički pregledi vozila i registracija na 10 stanica u Federaciji BiH. Pronađite najbližu stanicu, provjerite radno vrijeme i cjenovnik."
  active="/"
>
  <!-- HERO = alat: pronađi najbližu stanicu -->
  <section class="bg-ink-50 border-b border-ink-200">
    <div class="wrap py-10 md:py-14 grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="block text-brand-700" style="--logo-h: clamp(2.25rem, 7vw, 3.5rem)">
          <Logo podnaslov={false} />
        </span>
        <p class="mt-3 text-eyebrow uppercase text-brand-700">Tehnički pregledi vozila</p>
        <h1 class="text-display text-ink-900 mt-5">Pronađite najbližu stanicu</h1>
        <p class="mt-4 text-lg text-ink-600 leading-relaxed max-w-xl">
          Deset REMIS stanica u Federaciji BiH. Upišite grad da vidite lokaciju
          na mapi, ili otvorite spisak svih stanica.
        </p>

        <div class="mt-6 max-w-sm">
          <span id="grad-labela" class="block text-xs font-semibold uppercase tracking-wide text-ink-500 mb-1.5">
            Odaberite lokaciju
          </span>
          <div class="grad-select" data-grad-select>
            <button
              type="button"
              class="odabir grad-trigger"
              data-grad-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-labelledby="grad-labela grad-vrijednost"
            >
              <span id="grad-vrijednost" data-grad-vrijednost>Odaberite stanicu</span>
              <Icon name="chevron-down" size={18} class="grad-strelica text-ink-400 shrink-0" />
            </button>
            <ul class="grad-panel" data-grad-panel role="listbox" aria-labelledby="grad-labela" hidden>
              {
                gradoviList.map((g) => (
                  <li
                    class="grad-option"
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                    data-slug={g.slug}
                    data-lng={g.lng}
                    data-lat={g.lat}
                  >
                    {g.labela}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <p class="mt-3 text-sm text-ink-600" data-rezultat aria-live="polite"></p>
        <a href="/stanice" class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-brand-700">
          Sve stanice
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div
        class="mapa h-80 md:h-[420px]"
        data-home-mapa
        data-markeri={JSON.stringify(markeri)}
        role="region"
        aria-label="Mapa svih stanica"
      >
        <noscript>
          <div class="mapa-fallback">Za prikaz mape potreban je JavaScript. <a href="/stanice" class="underline">Spisak stanica</a>.</div>
        </noscript>
      </div>
    </div>
  </section>

  <!-- Brzi linkovi -->
  <section class="wrap py-12" data-reveal>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        brzi.map((b) => (
          <a href={b.href} class="card card--hover p-5 flex items-center gap-4">
            <span class="w-11 h-11 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center shrink-0">
              <Icon name={b.icon} size={20} />
            </span>
            <span>
              <span class="block font-semibold text-ink-900">{b.naziv}</span>
              <span class="block text-sm text-ink-600 mt-0.5">{b.opis}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Usluge -->
  <section class="wrap py-6" data-reveal>
    <SectionHeading eyebrow="Šta radimo" title="Naše usluge" description="Tehnički pregled svih kategorija vozila, registracija i osiguranje — na jednom mjestu." />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        usluge.map((u) => (
          <a href={`/usluge/${u.data.slug}`} class="card card--hover p-5 flex items-start gap-3">
            <span class="mt-0.5 text-brand-700 shrink-0"><Icon name="check" size={18} /></span>
            <span>
              <span class="block font-semibold text-ink-900">{u.data.naziv}</span>
              <span class="block text-sm text-ink-600 mt-1">{u.data.kratkiOpis}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Brojevi -->
  <section class="bg-ink-50 border-y border-ink-200 my-12" data-reveal>
    <div class="wrap py-10 grid grid-cols-3 gap-6 text-center">
      {
        brojevi.map((b) => (
          <div>
            <p class="text-4xl md:text-5xl font-extrabold tabular-nums text-brand-700">
              {b.count !== null ? <span data-count={b.count}>{b.broj}</span> : b.broj}
            </p>
            <p class="text-sm text-ink-600 mt-1">{b.opis}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- O firmi -->
  <section class="wrap py-6" data-reveal>
    <div class="max-w-2xl">
      <SectionHeading eyebrow="O nama" title="Pouzdano od 1990." />
      <p class="mt-4 text-ink-600 leading-relaxed">
        REMIS d.o.o. Visoko posluje od 1990. godine. Danas kroz mrežu od deset
        stanica u Federaciji BiH obavljamo tehnički pregled i registraciju
        vozila svih kategorija. Sjedište firme je u Visokom.
      </p>
      <a href="/o-nama" class="btn btn--secondary mt-6">
        Više o firmi
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(organizacijaJsonLd)} is:inline />

  <script>
    import { inicijalizirajMapu, type MarkerPodatak, type MapaRezultat } from '../lib/mapa';

    const kontejner = document.querySelector<HTMLElement>('[data-home-mapa]');
    const rezultat = document.querySelector<HTMLElement>('[data-rezultat]');

    let mapa: MapaRezultat | null = null;
    let markeri: MarkerPodatak[] = [];

    if (kontejner) {
      try {
        markeri = JSON.parse(kontejner.dataset.markeri ?? '[]');
      } catch {
        markeri = [];
      }

      const obs = new IntersectionObserver(
        (unosi, o) => {
          if (!unosi.some((u) => u.isIntersecting) || mapa) return;
          o.disconnect();
          inicijalizirajMapu(kontejner, markeri, {
            popupHtml: (m) =>
              `<strong>${m.naziv}</strong><br><a href="/stanice/${m.slug}">Detalji stanice →</a>`,
          }).then((r) => {
            mapa = r;
          });
        },
        { rootMargin: '200px' },
      );
      obs.observe(kontejner);
    }

    // --- Custom dropdown za izbor lokacije (bez kucanja, otvara prema dolje) ---
    const select = document.querySelector<HTMLElement>('[data-grad-select]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-grad-trigger]');
    const panel = document.querySelector<HTMLElement>('[data-grad-panel]');
    const vrijednost = document.querySelector<HTMLElement>('[data-grad-vrijednost]');
    const opcije = Array.from(document.querySelectorAll<HTMLElement>('.grad-option'));

    function otvoren(): boolean {
      return trigger?.getAttribute('aria-expanded') === 'true';
    }
    function postavi(otvori: boolean): void {
      if (!trigger || !panel) return;
      trigger.setAttribute('aria-expanded', String(otvori));
      panel.hidden = !otvori;
    }
    function fokusiraj(i: number): void {
      const n = opcije.length;
      if (n === 0) return;
      const idx = ((i % n) + n) % n;
      opcije.forEach((o) => o.classList.remove('istaknut'));
      opcije[idx]!.classList.add('istaknut');
      opcije[idx]!.focus();
    }

    trigger?.addEventListener('click', () => {
      const novo = !otvoren();
      postavi(novo);
      if (novo) fokusiraj(0);
    });

    trigger?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        postavi(true);
        fokusiraj(0);
      }
    });

    function odaberi(o: HTMLElement): void {
      opcije.forEach((x) => x.setAttribute('aria-selected', 'false'));
      o.setAttribute('aria-selected', 'true');
      if (vrijednost) vrijednost.textContent = o.textContent?.trim() ?? '';
      postavi(false);
      trigger?.focus();

      const slug = o.dataset.slug ?? '';
      const lng = Number(o.dataset.lng);
      const lat = Number(o.dataset.lat);
      const naziv = o.textContent?.trim() ?? '';
      if (rezultat) {
        rezultat.innerHTML = `Odabrano: <strong>${naziv}</strong> — <a href="/stanice/${slug}" class="text-brand-700 font-medium">otvori stanicu →</a>`;
      }
      mapa?.map.flyTo({ center: [lng, lat], zoom: 14, duration: 800 });
      mapa?.markeri[slug]?.togglePopup();
      kontejner?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    opcije.forEach((o, i) => {
      o.addEventListener('click', () => odaberi(o));
      o.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          odaberi(o);
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          fokusiraj(i + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          fokusiraj(i - 1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          fokusiraj(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          fokusiraj(opcije.length - 1);
        }
      });
    });

    // Zatvori na klik izvan i na Esc.
    document.addEventListener('click', (e) => {
      if (otvoren() && select && !select.contains(e.target as Node)) postavi(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && otvoren()) {
        postavi(false);
        trigger?.focus();
      }
    });
  </script>
</PageLayout>
