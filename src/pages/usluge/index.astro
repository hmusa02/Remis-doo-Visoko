---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';

const usluge = (await getCollection('usluge')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);
---

<PageLayout
  title="Usluge — tehnički pregled i registracija | REMIS"
  description="Tehnički pregled svih kategorija vozila, vanredni i preventivni pregled, registracija i osiguranje vozila na REMIS stanicama u FBiH."
  active="/usluge"
>
  <section class="wrap pt-8">
    <Breadcrumbs items={[{ label: 'Početna', href: '/' }, { label: 'Usluge' }]} />
    <div class="mt-6">
      <SectionHeading
        as="h1"
        eyebrow="Šta radimo"
        title="Usluge"
        description="Kompletan tehnički pregled i registracija vozila svih kategorija — na jednom mjestu, na svih 10 stanica."
      />
    </div>
  </section>

  <section class="wrap mt-8 mb-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        usluge.map((u) => (
          <a href={`/usluge/${u.data.slug}`} class="card card--hover p-5 flex flex-col gap-3">
            <span class="w-11 h-11 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center">
              <Icon name="check" size={20} />
            </span>
            <span>
              <span class="block font-semibold text-ink-900">{u.data.naziv}</span>
              <span class="block text-sm text-ink-600 mt-1">{u.data.kratkiOpis}</span>
            </span>
            <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
              Detalji
              <Icon name="chevron-right" size={15} />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</PageLayout>
