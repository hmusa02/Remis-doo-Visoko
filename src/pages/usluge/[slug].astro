---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import Table from '../../components/Table.astro';
import Icon from '../../components/Icon.astro';
import { cjenovnik } from '../../data/cjenovnik';
import { formatKM } from '../../lib/format';

export async function getStaticPaths() {
  const usluge = await getCollection('usluge');
  return usluge.map((usluga) => ({
    params: { slug: usluga.data.slug },
    props: { usluga },
  }));
}

const { usluga } = Astro.props;
const u = usluga.data;

// Mapiranje usluge → kategorije cjenovnika (gdje je cijena primjenjiva).
const CIJENA_MAPA: Record<string, string[]> = {
  'tehnicki-pregled-putnickih-vozila': ['M1'],
  'tehnicki-pregled-teretnih-vozila': ['N1', 'N2', 'N3'],
  'tehnicki-pregled-autobusa': ['M2', 'M3'],
  'tehnicki-pregled-motocikala': ['L1-L2', 'L3-L5', 'L6-L7'],
  'tehnicki-pregled-prikljucnih-vozila': ['O1', 'O2', 'O3', 'O4'],
  'tehnicki-pregled-traktora': ['T1-T5'],
};
const kodovi = CIJENA_MAPA[u.slug] ?? [];
const cjenovnikRedovi = cjenovnik
  .filter((s) => kodovi.includes(s.kod))
  .map((s) => ({
    vozilo: s.varijanta ? `${s.naziv} — ${s.varijanta}` : s.naziv,
    vanredni: formatKM(s.vanredni),
    redovni: formatKM(s.redovni),
  }));

const imaDokumente = Array.isArray(u.potrebniDokumenti) && u.potrebniDokumenti.length > 0;

// Stanice — dok ne stignu podaci po usluzi, prikazujemo sve stanice.
const stanice = (await getCollection('stanice')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);
---

<PageLayout
  title={`${u.naziv} — REMIS`}
  description={u.kratkiOpis}
  active="/usluge"
>
  <section class="wrap pt-8">
    <Breadcrumbs
      items={[
        { label: 'Početna', href: '/' },
        { label: 'Usluge', href: '/usluge' },
        { label: u.naziv },
      ]}
    />
  </section>

  <section class="wrap mt-6 max-w-3xl">
    <div class="flex items-center gap-2 text-eyebrow uppercase text-brand-700">
      <span class="w-6 h-px bg-brand-700"></span>
      Usluga
    </div>
    <h1 class="text-display text-ink-900 mt-3">{u.naziv}</h1>
    <p class="mt-4 text-lg text-ink-600 leading-relaxed">{u.opis}</p>

    {
      u.trajanje && (
        <p class="mt-4 inline-flex items-center gap-2 text-sm text-ink-600">
          <Icon name="clock" size={16} class="text-ink-400" />
          Trajanje: {u.trajanje}
        </p>
      )
    }
  </section>

  <!-- Potrebni dokumenti (samo ako postoje) -->
  {
    imaDokumente && (
      <section class="wrap mt-10 max-w-3xl">
        <h2 class="text-title text-ink-900 mb-4">Potrebni dokumenti</h2>
        <Card class="p-6">
          <ul class="space-y-2.5">
            {u.potrebniDokumenti!.map((dok) => (
              <li class="flex items-start gap-2.5 text-ink-700">
                <Icon name="check" size={18} class="text-brand-700 mt-0.5 shrink-0" />
                <span>{dok}</span>
              </li>
            ))}
          </ul>
        </Card>
      </section>
    )
  }

  <!-- Cijena (ako je primjenjiva) -->
  {
    cjenovnikRedovi.length > 0 && (
      <section class="wrap mt-10 max-w-3xl">
        <h2 class="text-title text-ink-900 mb-4">Cijena</h2>
        <Table
          caption={`Cijena — ${u.naziv}`}
          columns={[
            { key: 'vozilo', label: 'Vozilo' },
            { key: 'vanredni', label: 'Vanredni / preventivni', numeric: true },
            { key: 'redovni', label: 'Redovni / eksploatacioni', numeric: true },
          ]}
          rows={cjenovnikRedovi}
        />
        <a href="/cjenovnik" class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-brand-700">
          Cijeli cjenovnik
          <Icon name="arrow-right" size={16} />
        </a>
      </section>
    )
  }

  <!-- Stanice -->
  <section class="wrap mt-12 mb-4">
    <h2 class="text-title text-ink-900 mb-2">Gdje se radi</h2>
    <p class="text-sm text-ink-500 mb-4">Dostupno na svim REMIS stanicama u Federaciji BiH.</p>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        stanice.map((s) => (
          <a href={`/stanice/${s.data.slug}`} class="card card--hover p-4 flex items-center justify-between gap-3">
            <span>
              <span class="block font-medium text-ink-900">{s.data.naziv}</span>
              <span class="block text-xs text-ink-500">{s.data.grad}</span>
            </span>
            <Icon name="chevron-right" size={18} class="text-brand-700 shrink-0" />
          </a>
        ))
      }
    </div>
  </section>
</PageLayout>
