---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Table from '../components/Table.astro';
import Icon from '../components/Icon.astro';
import { cjenovnik, vaziOd, type KategorijaVozila } from '../data/cjenovnik';
import { vazenjeRjesenja } from '../data/vazenje-rjesenja';
import { formatKM, formatDatum } from '../lib/format';

const kategorije: KategorijaVozila[] = ['Motocikli', 'Putnička', 'Teretna', 'Priključna', 'Traktori'];

// M1 — tri odvojena reda (najtraženija cijena)
const m1 = cjenovnik.filter((s) => s.kod === 'M1');

const kolone = [
  { key: 'vozilo', label: 'Vozilo' },
  { key: 'vanredni', label: 'Vanredni / preventivni', numeric: true },
  { key: 'redovni', label: 'Redovni / eksploatacioni', numeric: true },
];

function redoviZa(kat: KategorijaVozila) {
  return cjenovnik
    .filter((s) => s.kategorija === kat)
    .map((s) => ({
      vozilo: s.varijanta ? `${s.naziv} — ${s.varijanta}` : s.naziv,
      vanredni: formatKM(s.vanredni),
      redovni: formatKM(s.redovni),
    }));
}
---

<PageLayout
  title="Cjenovnik tehničkog pregleda — REMIS"
  description="Cijene tehničkog pregleda po kategorijama vozila (KM). Iste cijene vrijede na svih 10 REMIS stanica u Federaciji BiH."
  active="/cjenovnik"
>
  <section class="wrap pt-8">
    <Breadcrumbs items={[{ label: 'Početna', href: '/' }, { label: 'Cjenovnik' }]} />
    <div class="mt-6">
      <SectionHeading
        as="h1"
        eyebrow="Cijene u KM"
        title="Cjenovnik"
        description="Cijene tehničkog pregleda po kategorijama vozila. Iste cijene vrijede na svim našim stanicama."
      />
      <p class="mt-4 inline-flex items-center gap-2 text-sm text-ink-600 bg-ink-50 border border-ink-200 rounded-md px-3 py-1.5">
        <Icon name="check" size={15} class="text-brand-700" />
        Cjenovnik važeći od {formatDatum(vaziOd)}
      </p>
    </div>
  </section>

  <!-- M1 istaknuto (najtraženija cijena — vidi se na prvi pogled) -->
  <section class="wrap mt-8">
    <Card class="p-6 md:p-8 border-brand-200">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-eyebrow uppercase text-brand-700">Najtraženije</p>
          <h2 class="text-title text-ink-900 mt-1">Putnički automobil (M1)</h2>
          <p class="text-sm text-ink-500 mt-1">Do 8 sjedišta · redovni tehnički pregled</p>
        </div>
        <div class="text-sm text-ink-500">
          Vanredni / preventivni: <span class="font-semibold text-ink-900 tabular-nums">{formatKM(m1[0]!.vanredni)}</span>
        </div>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          m1.map((s) => (
            <div class="rounded-card border border-ink-200 bg-ink-50 p-4">
              <p class="text-xs uppercase tracking-wide text-ink-500">{s.varijanta}</p>
              <p class="text-2xl md:text-3xl font-extrabold tabular-nums text-brand-700 mt-1">{formatKM(s.redovni)}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-ink-400">Prikazane cijene su za redovni (eksploatacioni) pregled.</p>
    </Card>
  </section>

  <!-- Tabele po kategorijama -->
  <section class="wrap mt-10 space-y-10">
    {
      kategorije.map((kat) => (
        <div>
          <h2 class="text-title text-ink-900 mb-4">{kat}</h2>
          <Table columns={kolone} rows={redoviZa(kat)} caption={`Cjenovnik — ${kat}`} />
        </div>
      ))
    }
  </section>

  <!-- Važenje rješenja -->
  <section class="wrap mt-14">
    <SectionHeading
      eyebrow="Registracija"
      title="Važenje eksploatacionih rješenja"
      description="Koliko dugo važi rješenje o registraciji, ovisno o starosti vozila."
    />
    <div class="mt-6 max-w-2xl">
      <Table
        caption="Važenje rješenja prema starosti vozila"
        columns={[
          { key: 'opis', label: 'Starost vozila' },
          { key: 'trajanje', label: 'Rješenje važi', numeric: true },
        ]}
        rows={vazenjeRjesenja.map((v) => ({ opis: v.opis, trajanje: v.trajanje }))}
      />
    </div>
  </section>

  <!-- Napomena -->
  <section class="wrap mt-10 mb-4">
    <p class="text-sm text-ink-500 bg-ink-50 border border-ink-200 rounded-md px-4 py-3">
      Sve cijene su izražene u konvertibilnim markama (KM). Cjenovnik je jedinstven
      i vrijedi na svih 10 REMIS stanica u Federaciji BiH. Za dodatna pojašnjenja
      <a href="/kontakt" class="text-brand-700 font-medium">kontaktirajte nas</a>.
    </p>
  </section>
</PageLayout>
