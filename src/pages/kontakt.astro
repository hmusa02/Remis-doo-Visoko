---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import MapaStanica from '../components/MapaStanica.astro';
import Forma from '../components/Forma.astro';
import { firma } from '../data/firma';
import type { MarkerPodatak } from '../lib/mapa';

const stanice = (await getCollection('stanice')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);
const markeri: MarkerPodatak[] = stanice.map((s) => ({
  slug: s.data.slug,
  naziv: s.data.naziv,
  lng: s.data.lng,
  lat: s.data.lat,
}));
const telSjediste = firma.telefon.replace(/[^\d+]/g, '');
---

<PageLayout
  title="Kontakt — REMIS d.o.o. Visoko"
  description="Kontaktirajte REMIS d.o.o. Visoko — sjedište firme, kontakti svih 10 stanica i kontakt forma."
  active="/kontakt"
>
  <section class="wrap pt-8">
    <Breadcrumbs items={[{ label: 'Početna', href: '/' }, { label: 'Kontakt' }]} />
    <div class="mt-6">
      <SectionHeading
        as="h1"
        eyebrow="Kontakt"
        title="Javite nam se"
        description="Sjedište firme, kontakti svih stanica i forma za upit."
      />
    </div>
  </section>

  <!-- Sjedište + forma -->
  <section class="wrap mt-8 grid gap-6 lg:grid-cols-2">
    <Card class="p-6">
      <h2 class="text-eyebrow uppercase text-ink-500 mb-4">Sjedište firme</h2>
      <address class="not-italic space-y-3 text-ink-700">
        <p class="flex items-start gap-3">
          <Icon name="building" size={18} class="text-ink-400 mt-0.5 shrink-0" />
          <span>
            {firma.naziv} <span class="text-ink-400">(uprava)</span><br />
            {firma.adresa}, {firma.postanskiBroj} {firma.grad}
          </span>
        </p>
        <a href={`tel:${telSjediste}`} class="flex items-center gap-3 hover:text-brand-700 transition-colors w-fit">
          <Icon name="phone" size={18} class="text-ink-400 shrink-0" />
          <span class="tabular-nums">{firma.telefon}</span>
        </a>
        <a href={`mailto:${firma.email}`} class="flex items-center gap-3 hover:text-brand-700 transition-colors w-fit">
          <Icon name="mail" size={18} class="text-ink-400 shrink-0" />
          <span>{firma.email}</span>
        </a>
      </address>
      <p class="mt-4 text-xs text-ink-400 border-t border-ink-100 pt-3">
        Uprava firme — nije stanica tehničkog pregleda. Stanica u Visokom je na
        istoj adresi, ali ima poseban telefon
        (<a href="/stanice/visoko" class="text-brand-700">REMIS Visoko</a>).
      </p>
    </Card>

    <!-- Kontakt forma (Web3Forms) -->
    <Card class="p-6">
      <h2 class="text-eyebrow uppercase text-ink-500 mb-4">Pošaljite upit</h2>
      <Forma tip="kontakt" />
    </Card>
  </section>

  <!-- Mapa svih stanica -->
  <section class="wrap mt-10">
    <h2 class="text-title text-ink-900 mb-4">Sve stanice na mapi</h2>
    <MapaStanica markeri={markeri} class="h-80 md:h-[440px]" popup />
  </section>

  <!-- Kontakti po stanicama -->
  <section class="wrap mt-12 mb-4">
    <h2 class="text-title text-ink-900 mb-4">Kontakti stanica</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        stanice.map((s) => {
          const tel = s.data.telefon.replace(/[^\d+]/g, '');
          return (
            <Card class="p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="font-semibold text-ink-900">{s.data.naziv}</h3>
                  <p class="text-xs text-ink-500 mt-0.5">{s.data.grad} · {s.data.kanton}</p>
                </div>
                <a href={`/stanice/${s.data.slug}`} class="text-brand-700 shrink-0" aria-label={`Detalji — ${s.data.naziv}`}>
                  <Icon name="chevron-right" size={18} />
                </a>
              </div>
              <p class="flex items-start gap-2 text-sm text-ink-600 mt-3">
                <Icon name="map-pin" size={15} class="text-ink-400 mt-0.5 shrink-0" />
                <span>{s.data.adresa}, {s.data.postanskiBroj} {s.data.grad}</span>
              </p>
              {tel && (
                <a href={`tel:${tel}`} class="flex items-center gap-2 text-sm text-ink-700 hover:text-brand-700 transition-colors mt-2 w-fit">
                  <Icon name="phone" size={15} class="text-ink-400 shrink-0" />
                  <span class="tabular-nums">{s.data.telefon}</span>
                </a>
              )}
            </Card>
          );
        })
      }
    </div>
  </section>
</PageLayout>
