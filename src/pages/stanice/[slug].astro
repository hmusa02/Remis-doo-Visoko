---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RadnoVrijeme from '../../components/RadnoVrijeme.astro';
import MapaStanica from '../../components/MapaStanica.astro';
import GalerijaStanice from '../../components/GalerijaStanice.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import { slikeStanice } from '../../lib/slike';
import { statusStanice } from '../../lib/radno-vrijeme';
import { firma } from '../../data/firma';

export async function getStaticPaths() {
  const stanice = await getCollection('stanice');
  return stanice.map((stanica) => ({
    params: { slug: stanica.data.slug },
    props: { stanica },
  }));
}

const { stanica } = Astro.props;
const d = stanica.data;

const slike = slikeStanice(d.slug);

// Usluge: vlastite ako su definisane, inače opšti spisak (nikad prazan blok).
const sveUsluge = (await getCollection('usluge')).sort(
  (a, b) => a.data.redoslijed - b.data.redoslijed,
);
const imaVlastite = Array.isArray(d.usluge) && d.usluge.length > 0;
const prikazaneUsluge = imaVlastite
  ? sveUsluge.filter((u) => d.usluge!.includes(u.data.slug))
  : sveUsluge;

// Oglasi: samo aktivni za ovu stanicu.
const oglasi = (await getCollection('oglasi')).filter(
  (o) => o.data.stanica === d.slug && o.data.aktivan,
);

const telDigits = d.telefon.replace(/[^\d+]/g, '');
const navUrl = `https://www.google.com/maps/dir/?api=1&destination=${d.lat},${d.lng}`;
const status = statusStanice(d.radnoVrijeme);

// --- JSON-LD (AutomotiveBusiness) ---
function raspon(v: string): { opens: string; closes: string } | null {
  const m = v.match(/^(\d{1,2}):(\d{2})-(\d{1,2}):(\d{2})$/);
  if (!m) return null;
  const pad = (h: string) => h.padStart(2, '0');
  return { opens: `${pad(m[1]!)}:${m[2]}`, closes: `${pad(m[3]!)}:${m[4]}` };
}
const ohs: Array<Record<string, unknown>> = [];
const rPon = raspon(d.radnoVrijeme.ponPet);
if (rPon)
  ohs.push({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: rPon.opens,
    closes: rPon.closes,
  });
const rSub = raspon(d.radnoVrijeme.subota);
if (rSub)
  ohs.push({ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: rSub.opens, closes: rSub.closes });
const rNed = raspon(d.radnoVrijeme.nedjelja);
if (rNed)
  ohs.push({ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: rNed.opens, closes: rNed.closes });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  name: d.naziv,
  address: {
    '@type': 'PostalAddress',
    streetAddress: d.adresa,
    postalCode: d.postanskiBroj,
    addressLocality: d.grad,
    addressRegion: d.kanton,
    addressCountry: 'BA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: d.lat, longitude: d.lng },
  telephone: d.telefon,
  ...(d.email ? { email: d.email } : {}),
  url: new URL(`/stanice/${d.slug}`, Astro.site).href,
  openingHoursSpecification: ohs,
  areaServed: { '@type': 'AdministrativeArea', name: d.grad },
  parentOrganization: {
    '@type': 'Organization',
    name: firma.naziv,
    telephone: firma.telefon,
    email: firma.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: firma.adresa,
      postalCode: firma.postanskiBroj,
      addressLocality: firma.grad,
      addressCountry: 'BA',
    },
  },
};
---

<PageLayout
  title={`${d.naziv} — tehnički pregled | REMIS`}
  description={`${d.naziv}, ${d.adresa}, ${d.postanskiBroj} ${d.grad}. Radno vrijeme, lokacija i usluge tehničkog pregleda.`}
  active="/stanice"
>
  <section class="wrap pt-8">
    <Breadcrumbs
      items={[
        { label: 'Početna', href: '/' },
        { label: 'Stanice', href: '/stanice' },
        { label: d.naziv },
      ]}
    />
  </section>

  <!-- Naslov + osnovni podaci (vrh nosi stranicu — nema hero slike) -->
  <section class="wrap mt-8 grid gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2 text-eyebrow uppercase text-brand-700">
        <span class="w-6 h-px bg-brand-700"></span>
        {d.grad} · {d.kanton}
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-3">
        <h1 class="text-display text-ink-900">{d.naziv}</h1>
        <span data-radno={JSON.stringify(d.radnoVrijeme)}>
          <span class="badge" data-status-badge data-state={status.otvorena ? 'open' : 'closed'}>
            <span class="badge-dot"></span>
            <span data-status-label>{status.otvorena ? 'Otvoreno' : 'Zatvoreno'}</span>
          </span>
        </span>
      </div>

      <div class="mt-6 space-y-3 text-ink-700">
        <p class="flex items-start gap-3">
          <Icon name="map-pin" size={18} class="text-ink-400 mt-0.5 shrink-0" />
          <span>{d.adresa}, {d.postanskiBroj} {d.grad}</span>
        </p>
        {
          telDigits && (
            <a href={`tel:${telDigits}`} class="flex items-center gap-3 hover:text-brand-700 transition-colors w-fit">
              <Icon name="phone" size={18} class="text-ink-400 shrink-0" />
              <span class="tabular-nums">{d.telefon}</span>
            </a>
          )
        }
        {
          d.email && (
            <a href={`mailto:${d.email}`} class="flex items-center gap-3 hover:text-brand-700 transition-colors w-fit">
              <Icon name="mail" size={18} class="text-ink-400 shrink-0" />
              <span>{d.email}</span>
            </a>
          )
        }
      </div>

      {
        (d.napomena || d.pravnoLice) && (
          <div class="mt-5 space-y-2">
            {d.pravnoLice && (
              <p class="text-sm text-ink-600">
                <span class="font-semibold text-ink-800">Pravno lice:</span> {d.pravnoLice}
              </p>
            )}
            {d.napomena && (
              <p class="text-sm text-ink-600 bg-ink-50 border border-ink-200 rounded-md px-3 py-2">
                {d.napomena}
              </p>
            )}
          </div>
        )
      }

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={navUrl} target="_blank" rel="noopener" class="btn btn--primary">
          <Icon name="map-pin" size={18} />
          Navigacija
        </a>
        {telDigits && <a href={`tel:${telDigits}`} class="btn btn--secondary">
          <Icon name="phone" size={18} />
          Pozovi
        </a>}
      </div>
    </div>

    <!-- Radno vrijeme -->
    <div>
      <Card class="p-6">
        <h2 class="text-eyebrow uppercase text-ink-500 mb-4">Radno vrijeme</h2>
        <RadnoVrijeme radnoVrijeme={d.radnoVrijeme} istakniSubota />
      </Card>
    </div>
  </section>

  <!-- Galerija (horizontalni slider + lightbox) -->
  {slike.sve.length > 0 && <GalerijaStanice slike={slike.sve} naziv={d.naziv} />}

  <!-- Mapa lokacije -->
  <section class="wrap mt-10">
    <h2 class="text-title text-ink-900 mb-4">Lokacija</h2>
    <MapaStanica
      markeri={[{ slug: d.slug, naziv: d.naziv, lng: d.lng, lat: d.lat }]}
      zoom={15}
      class="h-72 md:h-96"
    />
  </section>

  <!-- Usluge -->
  <section class="wrap mt-12">
    <h2 class="text-title text-ink-900 mb-1">Usluge</h2>
    {
      !imaVlastite && (
        <p class="text-sm text-ink-500 mb-4">
          Opšti spisak usluga koje REMIS nudi. Za tačnu ponudu na ovoj stanici pozovite nas.
        </p>
      )
    }
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        prikazaneUsluge.map((u) => (
          <a href={`/usluge/${u.data.slug}`} class="card card--hover p-5 flex items-start gap-3">
            <span class="mt-0.5 text-brand-700 shrink-0">
              <Icon name="check" size={18} />
            </span>
            <span>
              <span class="block font-semibold text-ink-900">{u.data.naziv}</span>
              <span class="block text-sm text-ink-600 mt-1">{u.data.kratkiOpis}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Voditelj (samo ako postoji) -->
  {
    d.voditelj && (
      <section class="wrap mt-12">
        <h2 class="text-title text-ink-900 mb-4">Voditelj stanice</h2>
        <Card class="p-6 flex items-center justify-between gap-4 max-w-md">
          <div>
            <p class="font-semibold text-ink-900">{d.voditelj.ime}</p>
            <p class="text-sm text-ink-500">Voditelj</p>
          </div>
          <a href={`tel:${d.voditelj.telefon.replace(/[^\d+]/g, '')}`} class="btn btn--secondary btn--sm">
            <Icon name="phone" size={16} />
            {d.voditelj.telefon}
          </a>
        </Card>
      </section>
    )
  }

  <!-- Otvorene pozicije (samo ako ima aktivan oglas) -->
  {
    oglasi.length > 0 && (
      <section class="wrap mt-12">
        <h2 class="text-title text-ink-900 mb-4">Otvorene pozicije</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {oglasi.map((o) => (
            <Card class="p-5">
              <h3 class="font-semibold text-ink-900">{o.data.pozicija}</h3>
              <p class="text-sm text-ink-600 mt-1">{o.data.opis}</p>
              <a href={`/karijera/${o.data.slug}`} class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-brand-700">
                Detalji i prijava
                <Icon name="chevron-right" size={15} />
              </a>
            </Card>
          ))}
        </div>
      </section>
    )
  }

  <!-- Linkovi -->
  <section class="wrap mt-12 mb-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/cjenovnik" class="card card--hover p-5 flex items-center justify-between">
        <span>
          <span class="block font-semibold text-ink-900">Cjenovnik</span>
          <span class="block text-sm text-ink-600 mt-0.5">Cijene tehničkog pregleda po kategorijama vozila</span>
        </span>
        <Icon name="chevron-right" size={20} class="text-brand-700 shrink-0" />
      </a>
      <a href="/usluge" class="card card--hover p-5 flex items-center justify-between">
        <span>
          <span class="block font-semibold text-ink-900">Potrebni dokumenti</span>
          <span class="block text-sm text-ink-600 mt-0.5">Šta ponijeti na tehnički pregled i registraciju</span>
        </span>
        <Icon name="chevron-right" size={20} class="text-brand-700 shrink-0" />
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</PageLayout>
