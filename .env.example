# Kopiraj u .env (lokalno) i postavi iste varijable u Cloudflare Pages
# (Settings → Environment variables). Sve PUBLIC_ varijable idu u klijentski
# build, pa NE stavljaj tajne u njih.

# Web3Forms access key za forme (kontakt/prijava). Registruj besplatno na
# https://web3forms.com. Bez njega se forma ne prikazuje — umjesto nje ide
# neutralan kontakt (telefon + e-mail).
PUBLIC_WEB3FORMS_KEY=

# Indeksiranje. Podrazumijevano je sajt NOINDEX (sigurno za pages.dev).
# Za produkciju na pravom domenu postavi na "false" da se dozvoli indeksiranje.
PUBLIC_NOINDEX=true

# E-mail na koji stižu prijave za posao (prikazuje se i kao fallback kontakt na
# /karijera). Sam prijem se konfiguriše u Web3Forms nalogu vezanom za ključ.
PUBLIC_PRIJAVE_EMAIL=info@remis.ba
